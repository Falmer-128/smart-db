# ── Directory Configuration ──────────────────────────────────
# Paths are relative to the project root (or absolute).
INPUT_DIR=INPUT
PROCESSED_DIR=PROCESSED
OUTPUT_DIR=OUTPUT

# ── OCR Configuration ───────────────────────────────────────
OCR_LANGUAGES=rus+eng
OCR_DPI=300

# ── Processing ──────────────────────────────────────────────
# Minimum character count in a PDF text layer to consider it
# "readable" (below this threshold the file goes through OCR).
PDF_TEXT_THRESHOLD=50
